{
  "name": "rajshree-energy-tasks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @rajshree/web",
    "dev:api": "npm run dev -w @rajshree/api",
    "build": "npm run build -w @rajshree/shared && npm run build -w @rajshree/api && npm run build -w @rajshree/web",
    "build:shared": "npm run build -w @rajshree/shared",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
