{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build:shared && npm run build -w @rajshree/api"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run build:shared && npm run build -w @rajshree/web",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-occurrences",
      "schedule": "0 0 * * *"
    }
  ]
}
